# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
/.dev.vars*
!.env.example
*.tsbuildinfo

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# Local caches, runtime data, exports, and private key material.
node_modules/
.cache/
.vite/
.turbo/
*.log
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.key
*.p12
*.pfx
*.keystore
credentials*.json
service-account*.json
/uploads/
/backups/
/test-data/
/tests/output/
/test-results/
/playwright-report/
/public/demo-*.svg
